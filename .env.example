# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
# Leave empty or omit to use the automatic zero-config embedded MongoDB memory engine
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority"

# JWT Secret for signing and verifying customer authentication tokens
JWT_SECRET="your_production_jwt_secret_key_change_me_in_prod"
